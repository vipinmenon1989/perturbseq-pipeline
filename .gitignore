# =========================================================================
# Repository tracking policy
#
# TRACK:    source code (.py/.R/.sh/.slurm/.sbatch), lightweight YAML/JSON
#           configuration, Markdown documentation, packaging metadata,
#           notebooks, and the small demo metadata needed to reproduce runs.
#
# DO NOT TRACK: datasets, analysis objects, result tables, generated
#           figures, logs, archives, caches. Those stay on the filesystem
#           / DRIVE_PIPELINE_DIR and are regenerated by the pipeline.
#
# .gitignore does not untrack files that are already in the index. When a
# pattern is added here, the matching tracked files must also be removed
# with `git rm --cached <path>` (the local copies are kept).
# =========================================================================


# -------------------------------------------------------------------------
# Single-cell / large data objects
# -------------------------------------------------------------------------
*.h5ad
*.h5
*.hdf5
*.loom
*.zarr/
*.mtx
*.mtx.gz
*.rds
*.rdata
*.RData


# -------------------------------------------------------------------------
# Tabular result / data files
#
# Exception: demo/sample_metadata.csv is a tiny reproducibility fixture for
# the bundled demo dataset and is intentionally tracked.
# -------------------------------------------------------------------------
*.csv
*.tsv
*.txt
!demo/sample_metadata.csv
!requirements*.txt
!**/requirements*.txt


# -------------------------------------------------------------------------
# Serialized / intermediate objects
# -------------------------------------------------------------------------
*.pkl
*.pickle
*.npy
*.npz
*.joblib
*.feather
*.parquet


# -------------------------------------------------------------------------
# Generated figures
#
# The repository is code-only: figures are regenerated from the pipeline.
# Reports reference them by relative path rather than committing them.
# -------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.gif
*.svg
*.pdf
*.eps
*.wmf
*.emf


# -------------------------------------------------------------------------
# Office / rendered documents produced by analyses
# -------------------------------------------------------------------------
*.docx
*.pptx
*.xlsx


# -------------------------------------------------------------------------
# Logs and scheduler output
# -------------------------------------------------------------------------
*.log
*.err
*.out
logs/
slurm-*.out


# -------------------------------------------------------------------------
# Archives
# -------------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.bz2
*.xz
*.7z


# -------------------------------------------------------------------------
# Run outputs, data, caches
#
# results/ is fully ignored except for hand-written Markdown reports that
# are part of the project documentation. Git cannot re-include a file whose
# parent directory is excluded, so the path is re-opened level by level.
# -------------------------------------------------------------------------
data/
demo_data/
cache/
scratch/results_*/
scratch/stress_test/
scratch/smoke_data/

results/*
!results/diabetes_specific/
results/diabetes_specific/*

# The canonical scientific report.
!results/diabetes_specific/diabetes-progenitor-study.md

# Curated report figures. These are the 21 figures embedded in the source
# Word report, extracted byte-identical and referenced by relative path from
# diabetes-progenitor-study.md. They are the documented exception to the
# code-only policy: without them the canonical report does not render.
# Bulk generated figures under results/**/figures/ stay ignored.
!results/diabetes_specific/report_figures/
!results/diabetes_specific/report_figures/*.png
!results/diabetes_specific/report_figures/*.jpg
!results/diabetes_specific/report_figures/*.jpeg
!results/diabetes_specific/report_figures/*.svg
!results/diabetes_specific/report_figures/*.md

# Presentation / deck-generation code and its Markdown source documents.
# Re-opening this directory tracks the .py and .md files inside it; the decks
# themselves (*.pptx), extracted manuscript text (*.txt), rendered slide
# previews (*.png/*.jpg) and figure PDFs stay ignored by the type rules above.
!results/diabetes_specific/presentation/

# Self-referencing symlink left behind by a deck script's relative-path
# workaround (Presentation_Sep1/presentation -> .); recursive, never commit.
results/diabetes_specific/presentation/Presentation_Sep1/presentation

# Throwaway import smoke check, superseded by the deck builders themselves.
results/diabetes_specific/presentation/Presentation_Sep1/test_script_structure.py


# -------------------------------------------------------------------------
# HTML: only pipeline report *templates* are source; rendered reports are not.
# -------------------------------------------------------------------------
*.html
!src/perturbseq_pipeline/templates/*.html


# -------------------------------------------------------------------------
# JSON
#
# JSON is used for lightweight configuration in this repository, so it is
# NOT globally ignored. Only JSON written into result/scratch directories
# (figure manifests, run summaries) is excluded.
# -------------------------------------------------------------------------
results/**/*.json
scratch/**/*.json
workflows/results/**/*.json


# -------------------------------------------------------------------------
# Generated configs (machine-specific paths, written by fetch_demo_data.py)
# -------------------------------------------------------------------------
*.local.yaml


# -------------------------------------------------------------------------
# Configs and metadata for unpublished datasets — keep these on Drive
# -------------------------------------------------------------------------
*thp1*
*THP1*


# -------------------------------------------------------------------------
# Python
# -------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# -------------------------------------------------------------------------
# Notebooks
# -------------------------------------------------------------------------
.ipynb_checkpoints/


# -------------------------------------------------------------------------
# OS / editor
# -------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
